# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  SNYK-JS-XLSX-6252523:
    - '*':
        reason: >-
          Corregido en xlsx 0.20.3 via CDN oficial SheetJS (CVE-2024-22363 fixed
          in 0.20.2+). Falso positivo por versionado SheetJS fuera de npm.
        expires: 2027-12-31T00:00:00.000Z
  SNYK-JS-XLSX-5457926:
    - '*':
        reason: >-
          Corregido en xlsx 0.20.3 via CDN oficial SheetJS (CVE-2023-30533 fixed
          in 0.19.3+). Falso positivo por versionado SheetJS fuera de npm.
        expires: 2027-12-31T00:00:00.000Z
  SNYK-JS-FFLATE-22392372:
    - '*':
        reason: >-
          Transitiva de @react-three/drei (libreria de render 3D del bus, no
          maneja datos de usuario). fflate ya esta en su ultima version
          publicada (0.8.3); Snyk reporta "No upgrade or patch available".
          Riesgo aceptado hasta que exista parche upstream.
        expires: 2027-12-31T00:00:00.000Z
patch: {}
